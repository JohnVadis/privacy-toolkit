# Never commit real client PII or generated output.
# clients/* (not clients/*.yaml) so subfolders — notably clients/_backups/, which
# holds previous versions of real client files — can never slip in either.
clients/*
!clients/_TEMPLATE.yaml
output/
# Blank county forms are public documents, not client data, and a build machine
# cannot produce a working app without them. The real ones are tracked; any other
# PDF dropped in here (a scratch form, a client's own paperwork) is not. Adding a
# county's form to the packaged app = adding its blank PDF to this list (the
# packagers ship every mapping whose PDF is tracked — fill_forms.shipped_form_keys).
forms/_blank_pdfs/*.pdf
!forms/_blank_pdfs/demo_redaction.pdf
!forms/_blank_pdfs/Hillsborough_Redaction.pdf
!forms/_blank_pdfs/Hillsborough_Military_Confidentiality_Form_Refined2.pdf
!forms/_blank_pdfs/Hillsborough_Property_Appraisers_Exemption.pdf
!forms/_blank_pdfs/address-confidentiality-exemption-form-07-2025.pdf
__pycache__/
*.pyc
.venv/
venv/
trash/
# Previous versions of the opt-out site list, kept by the app on every change.
_sites_backups/

# Exported cases are a whole client in one file, in plaintext.
exports/

# Screenshots taken by the Comment feature show client data
feedback/
build/
dist/
*.spec
